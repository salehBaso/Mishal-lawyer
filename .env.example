# ==========================================================================
# شركة مشعل الجهني للمحاماة والاستشارات — Environment Variables
# انسخ هذا الملف إلى .env.local ولا تقم أبدًا برفع .env الحقيقي إلى git
# ==========================================================================

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="شركة مشعل الجهني للمحاماة والاستشارات"
NODE_ENV="development"

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mishal_legal?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/mishal_legal?schema=public"

# --- Auth (Auth.js / NextAuth v5) ---
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"
# MFA (TOTP) — ready-to-enable, معطّل افتراضيًا لتسهيل التطوير
MFA_ENFORCED_ROLES="SUPER_ADMIN,FIRM_ADMIN,MANAGING_PARTNER,ACCOUNTANT"

# --- Redis (Sessions cache / Rate limiting / Queues) ---
REDIS_URL="redis://localhost:6379"

# --- Object Storage (S3-compatible: AWS S3 / DigitalOcean Spaces / Cloudflare R2) ---
STORAGE_PROVIDER="s3" # s3 | local (local للتطوير فقط)
STORAGE_BUCKET="mishal-legal-documents"
STORAGE_REGION="me-central-1"
STORAGE_ENDPOINT="" # اتركه فارغًا لاستخدام AWS الافتراضي، أو ضع endpoint مزود آخر
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_SIGNED_URL_TTL_SECONDS="900"

# --- Payments (Adapter pattern — فعّل مزودًا واحدًا فقط عبر PAYMENT_PROVIDER) ---
PAYMENT_PROVIDER="moyasar" # moyasar | hyperpay | tap | stripe
MOYASAR_SECRET_KEY=""
MOYASAR_PUBLISHABLE_KEY=""
MOYASAR_WEBHOOK_SECRET=""
HYPERPAY_ENTITY_ID=""
HYPERPAY_ACCESS_TOKEN=""
TAP_SECRET_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Najiz Developers (يتطلب اعتماد رسمي من وزارة العدل / ناجز) ---
NAJIZ_ENV="sandbox" # sandbox | production
NAJIZ_BASE_URL="https://sandbox-api.najiz.sa" # TODO: استبدلها بالـ Base URL الرسمي عند الاعتماد
NAJIZ_CLIENT_ID=""
NAJIZ_CLIENT_SECRET=""
NAJIZ_SUBSCRIPTION_KEY=""

# --- AI Provider (Adapter pattern — LLM API قابل للاستبدال) ---
AI_PROVIDER="mock" # mock | anthropic | openai
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL="claude-sonnet-4-5"

# --- Notifications ---
NOTIFICATIONS_EMAIL_PROVIDER="resend" # resend
RESEND_API_KEY=""
NOTIFICATIONS_SMS_PROVIDER="" # e.g. unifonic | taqnyat
SMS_API_KEY=""
WHATSAPP_BUSINESS_TOKEN="" # يتطلب حساب WhatsApp Business API معتمد
WHATSAPP_PHONE_NUMBER_ID=""

# --- Security ---
RATE_LIMIT_WINDOW_SECONDS="60"
RATE_LIMIT_MAX_REQUESTS="100"
SESSION_MAX_AGE_SECONDS="28800" # 8 ساعات
CSRF_SECRET="generate-a-strong-random-secret"

# --- Observability (اختياري) ---
SENTRY_DSN=""
LOG_LEVEL="info"
